    "qa:scene-inventory": "node --import tsx scripts/profile-city-inventory.ts",
    "test:master-plan": "node --import tsx scripts/check-master-plan.ts && node --import tsx scripts/check-master-plan-drives.ts && node --import tsx scripts/check-tropical-batch.ts",
    "test:landmark-accuracy": "node --import tsx scripts/check-landmark-accuracy.ts && node --import tsx scripts/check-landmark-accuracy-drives.ts",
    "qa:landmark-accuracy": "node --import tsx scripts/survey-landmark-accuracy.ts",
    "test:historic-core": "node --import tsx scripts/check-historic-reconstruction.ts && node --import tsx scripts/check-historic-drives.ts && HISTORIC_INTERSECTIONS=1 node --import tsx scripts/check-historic-drives.ts",
    "test:historic-fidelity": "node --import tsx scripts/check-historic-fidelity.ts",
    "test:city-blueprint": "node --import tsx scripts/check-city-blueprint.ts",
    "test:premium-landmarks": "node --import tsx scripts/check-premium-landmarks.ts && node --import tsx scripts/check-premium-drives.ts",
    "test:river-geography": "node --import tsx scripts/check-chao-phraya.ts",
    "test:river-drives": "node --import tsx scripts/check-chao-drives.ts",
    "test:waterfront-clearance": "node --import tsx scripts/check-waterfront-clearance.ts",
    "test:waterfront-drives": "node --import tsx scripts/check-waterfront-drives.ts && WATERFRONT_LANES=1 node --import tsx scripts/check-waterfront-drives.ts",
    "test:chinatown": "node --import tsx scripts/check-chinatown.ts",
