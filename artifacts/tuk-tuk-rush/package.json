{
  "name": "@workspace/tuk-tuk-rush",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:gameplay": "node --import tsx scripts/check-gameplay.ts && node --import tsx scripts/check-driven-mission.ts",
    "test:assets": "node scripts/check-assets.mjs",
    "test:street-life": "node --import tsx scripts/check-street-life.ts",
    "test:roadside": "node --import tsx scripts/check-roadside.ts",
    "test:signature": "node --import tsx scripts/check-signature.ts",
    "test:sign-layers": "node --import tsx scripts/check-sign-layers.ts",
    "test:bangkok": "node --import tsx scripts/check-bangkok.ts && node --import tsx scripts/check-bangkok-driven.ts && node --import tsx scripts/check-bangkok-map.tsx && node --import tsx scripts/check-bangkok-architecture.ts",
    "test:environment": "node --import tsx scripts/check-environment-art.ts",
    "test:cityscapes": "node --import tsx scripts/check-cityscapes.ts",
    "test:definitive": "node --import tsx scripts/check-definitive-world.ts && node --import tsx scripts/check-road-render-surface.ts",
    "art:roads": "node --import tsx scripts/generate-road-surfaces.ts",
    "test:open-bangkok": "node --import tsx scripts/check-open-bangkok.ts",
    "test:startup": "node scripts/check-startup.mjs",
    "test:landmark-quality": "node --import tsx scripts/check-landmark-quality.ts && node --import tsx scripts/check-sign-fonts.ts && node --import tsx scripts/check-batch-materials.ts"
  },
