{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bangkok canonical approval v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "baselineCommit",
    "compression",
    "roadBaseline",
    "geographicReferences",
    "features",
    "baseLayout",
    "facadeApproaches",
    "infrastructure"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baselineCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "model",
          "featureOffset",
          "compressionReason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "object",
            "required": [
              "origin",
              "rotation",
              "size",
              "design",
              "placement"
            ],
            "properties": {
              "origin": {
                "$ref": "#/$defs/point"
              },
              "rotation": {
                "type": "number"
              },
              "size": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "design": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "featureOffset": {
            "$ref": "#/$defs/point"
          },
          "compressionReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "geographicReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "coordinate",
          "sources"
        ],
        "properties": {
          "coordinate": {
            "$ref": "#/$defs/wgs84"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "roadBaseline": {
      "type": "object",
      "required": [
        "version",
        "key",
        "fullGraphKey",
        "roads",
        "nodes",
        "status"
      ]
    },
    "compression": {
      "type": "object",
      "required": [
        "version",
        "scale",
        "origin",
        "longitudeKnots",
        "southingKnots",
        "masterPlan"
      ]
    },
    "infrastructure": {
      "type": "object",
      "required": [
        "mrt",
        "piers"
      ]
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "wgs84": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  }
}
